#!/usr/bin/env bash
# Installed independently of the PR checkout; the SSH key can only run this command.
set -euo pipefail
if [[ ! ${SSH_ORIGINAL_COMMAND:-} =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
  echo 'usage: deploy <40-hex commit sha>' >&2
  exit 2
fi
sha=${BASH_REMATCH[1]}
cd "$HOME/.hermes/plugins/cadence"
exec 9>.git/alpha-deploy.lock
flock -w 600 9
[[ -x "$HOME/.local/bin/cadence-alpha-health" ]]
[[ -z $(git status --porcelain --untracked-files=normal) ]] || {
  echo 'refusing dirty plugin checkout' >&2; exit 1;
}
previous=$(git rev-parse HEAD)

check_health() {
  local since=$1 pid sample first=''
  for ((attempt=0; attempt<60; attempt++)); do
    pid=$(sudo -n systemctl show hermes-gateway --property=MainPID --value) || return 1
    if sample=$("$HOME/.local/bin/cadence-alpha-health" "$pid" "$since"); then
      if [[ -n $first && $sample != "$first" ]]; then return 0; fi
      first=$sample
    else
      first=''
    fi
    sleep 2
  done
  return 1
}

restart_and_check() {
  local since
  since=$(date +%s)
  sudo -n systemctl restart hermes-gateway || return 1
  check_health "$since"
}

if [[ $previous == "$sha" ]]; then
  check_health 0
  echo "already runs ${sha:0:7}; Cadence poller healthy"
  exit 0
fi

git fetch -q origin "$sha"
# Conservative dependency guard: no manifest change is automatically installed.
old_manifest=$(git show "$previous:plugin.yaml")
new_manifest=$(git show "$sha:plugin.yaml")
[[ $old_manifest == "$new_manifest" ]] || {
  echo 'plugin.yaml changed; manual manifest/dependency review and install required' >&2
  exit 1
}
git checkout -q --detach "$sha"
echo "$(date -Is) $previous -> $sha" >> .git/alpha-deploy.log
if restart_and_check; then
  echo "Cadence runs ${sha:0:7}, was ${previous:0:7}"
else
  echo "Cadence failed health on $sha; rolling back to $previous" >&2
  git checkout -q --detach "$previous"
  restart_and_check || echo 'rollback failed health too; manual recovery required' >&2
  exit 1
fi
